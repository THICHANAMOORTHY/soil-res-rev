{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/downloads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|download|downloads).*)",
      "destination": "/frontend/$1"
    }
  ]
}
